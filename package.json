{
  "homepage": "https://abedeen25.github.io/home",
  "name": "home",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@react-three/fiber": "^8.18.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "framer-motion": "^11.2.11",
    "gh-pages": "^6.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-gallery": "^1.0.1",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.2.1",
    "react-router-dom": "^6.27.0",
    "react-scripts": "5.0.1",
    "react-tooltip": "^5.26.4",
    "three": "^0.169.0",
    "web-vitals": "^2.1.4",
    "yet-another-react-lightbox": "^3.32.0"
  },
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "sass": "^1.77.5"
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(yet-another-react-lightbox|three|@react-three)/)"
    ],
    "moduleNameMapper": {
      "^yet-another-react-lightbox/styles.css$": "<rootDir>/node_modules/yet-another-react-lightbox/dist/styles.css"
    }
  }
